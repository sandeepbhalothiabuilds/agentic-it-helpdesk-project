# App
APP_NAME="Agentic IT Service Desk"
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8501
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1,backend,frontend

# API protection (optional locally; recommended for shared/prod environments)
API_KEY_REQUIRED=false
BACKEND_API_KEY=replace-me
FRONTEND_API_KEY=replace-me
API_KEY_HEADER=X-API-Key

# Database: set either DATABASE_URL or the DB_* values below.
DATABASE_URL=
DB_USER=service_desk
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=prefer
ENABLE_SQLITE_FALLBACK=true
SQLITE_FALLBACK_PATH=.agentic_it_service_desk_test.db

# LLM provider routing
# local/dev compatibility: LLM_PROVIDER=mistral
# AWS target: LLM_PROVIDER=bedrock
LLM_PROVIDER=mistral
LLM_FALLBACK_PROVIDER=mistral
LLM_FALLBACK_ENABLED=true

# Mistral fallback/local development
MISTRAL_API_KEY=replace-me
MISTRAL_MODEL=mistral-small-latest
MISTRAL_DISABLE=0
MISTRAL_INSECURE_SSL=0

# AWS / Amazon Bedrock
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_TEXT_MODEL_ID=replace-with-bedrock-model-id
BEDROCK_TEMPERATURE=0.2
BEDROCK_MAX_TOKENS=1024
BEDROCK_REQUEST_TIMEOUT_SECONDS=60
BEDROCK_VALIDATE_ON_STATUS=false
BEDROCK_GUARDRAIL_IDENTIFIER=
BEDROCK_GUARDRAIL_VERSION=

# Amazon Bedrock AgentCore Runtime
# local: AGENT_RUNTIME_PROVIDER=local
# AWS target after AgentCore deployment: AGENT_RUNTIME_PROVIDER=agentcore
AGENT_RUNTIME_PROVIDER=local
AGENTCORE_RUNTIME_ARN=
AGENTCORE_RUNTIME_QUALIFIER=
AGENTCORE_ACCOUNT_ID=
AGENTCORE_TIMEOUT_SECONDS=90
AGENTCORE_FALLBACK_TO_LOCAL=true
AGENTCORE_CONTENT_TYPE=application/json
AGENTCORE_ACCEPT=application/json

# Amazon Bedrock AgentCore Memory
# Enables managed conversation/session memory. Keep disabled until a Memory resource exists.
AGENTCORE_MEMORY_ENABLED=false
AGENTCORE_MEMORY_ID=
AGENTCORE_MEMORY_ACTOR_PREFIX=employee
AGENTCORE_MEMORY_WRITE_EVENTS=true
AGENTCORE_MEMORY_RETRIEVE_ENABLED=false
AGENTCORE_MEMORY_NAMESPACE=/service-desk/{actorId}/
AGENTCORE_MEMORY_STRATEGY_ID=
AGENTCORE_MEMORY_TOP_K=3

# Amazon Bedrock AgentCore Gateway / Identity
# Enables governed tool access. Keep fallback enabled until Gateway targets are wired.
AGENTCORE_GATEWAY_ENABLED=false
AGENTCORE_GATEWAY_URL=
AGENTCORE_GATEWAY_TIMEOUT_SECONDS=30
AGENTCORE_GATEWAY_FALLBACK_TO_MOCK=true
AGENTCORE_GATEWAY_TOOL_PREFIX=
AGENTCORE_IDENTITY_ENABLED=false
AGENTCORE_GATEWAY_BEARER_TOKEN=
AGENTCORE_GATEWAY_API_KEY=
AGENTCORE_GATEWAY_API_KEY_HEADER=X-API-Key
AGENTCORE_GATEWAY_AUTH_HEADER=Authorization

# Embeddings
# local/dev: EMBEDDING_PROVIDER=huggingface
# AWS target: EMBEDDING_PROVIDER=bedrock
EMBEDDING_PROVIDER=huggingface
EMBEDDING_FALLBACK_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=nomic-embed-text
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_EMBEDDING_NORMALIZE=true

# Retrieval provider
# db uses the existing PostgreSQL document_chunks table.
# bedrock_kb uses Amazon Bedrock Knowledge Bases with optional DB fallback.
RETRIEVAL_PROVIDER=db
RETRIEVAL_FALLBACK_TO_DB=true
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_KB_DATA_SOURCE_ID=
BEDROCK_KB_NUMBER_OF_RESULTS=5
BEDROCK_KB_SEARCH_TYPE=HYBRID

# Knowledge base and seed data
# local/dev: KB_STORAGE_BACKEND=local
# AWS target: KB_STORAGE_BACKEND=s3
KB_STORAGE_BACKEND=local
KB_STORAGE_ROOT=data/knowledge_base/uploads
KB_S3_BUCKET=
KB_S3_PREFIX=knowledge-base/uploads
KB_S3_PRESIGN_SECONDS=900
KB_S3_VALIDATE=false
KB_S3_SSE=
KB_S3_KMS_KEY_ID=
STRUCTURED_DATA_ROOT=data/raw/structured
